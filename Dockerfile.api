FROM python:3.11-slim-bookworm AS builder

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /build

RUN python -m venv "$VIRTUAL_ENV"

COPY requirements-api.txt .

RUN pip install --no-cache-dir --upgrade pip wheel setuptools==70.0.0 \
    && pip install --no-cache-dir --no-compile -r requirements-api.txt \
    && find "$VIRTUAL_ENV" -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && find "$VIRTUAL_ENV" -type d \( -name "test" -o -name "tests" \) -prune -exec rm -rf {} + \
    && find "$VIRTUAL_ENV" -type d \( \
        -name "docs" -o \
        -name "doc" -o \
        -name "examples" -o \
        -name "example" -o \
        -name "benchmarks" -o \
        -name "benchmark" \
    \) -prune -exec rm -rf {} + \
    && find "$VIRTUAL_ENV" -type f -name "*.pyc" -delete \
    && find "$VIRTUAL_ENV" -type f -name "*.pyo" -delete \
    && find "$VIRTUAL_ENV" -type f \( -name "*.pyi" -o -name "py.typed" \) -delete \
    && rm -rf "$VIRTUAL_ENV/lib/python3.11/site-packages/pip"* \
    && rm -rf /root/.cache/pip

FROM python:3.11-slim-bookworm AS runtime

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/api

WORKDIR /app/api

COPY --from=builder /opt/venv /opt/venv
COPY api/ /app/api/

RUN adduser --disabled-password --gecos "" appuser
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]